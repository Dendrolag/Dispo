# --- Développement local ---
# DATABASE_URL et DIRECT_URL peuvent pointer vers la même base locale.
DATABASE_URL="postgresql://user:password@localhost:5432/dispo?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/dispo?schema=public"

# --- Production (serverless : Vercel + Neon/Supabase) ---
# DATABASE_URL : connexion POOLÉE (pgbouncer) utilisée par l'app.
#   Neon     -> ...-pooler.<region>.aws.neon.tech/...  (ajouter ?sslmode=require)
#   Supabase -> port 6543, ajouter ?pgbouncer=true
# DIRECT_URL  : connexion DIRECTE (non poolée) utilisée par les migrations.
#   Neon     -> hôte sans « -pooler »
#   Supabase -> port 5432
