# --- Développement local ---
# Les deux variables peuvent pointer vers la même base locale.
DATABASE_URL="postgresql://user:password@localhost:5432/dispo?schema=public"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/dispo?schema=public"

# --- Production (Vercel + Neon) ---
# Ces variables sont créées automatiquement par l'intégration Neon de Vercel :
#   DATABASE_URL          -> connexion POOLÉE (hôte « -pooler »), utilisée par l'app
#   DATABASE_URL_UNPOOLED -> connexion DIRECTE, utilisée par les migrations
# Aucune saisie manuelle nécessaire.
